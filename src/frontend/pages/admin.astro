---
/**
 * admin.astro — Main admin page.
 *
 * URL patterns:
 *   /admin                           → Dashboard / welcome
 *   /admin?collection=blog           → List blog posts
 *   /admin?collection=blog&action=new → New blog post form
 *   /admin?collection=blog&slug=my-post&action=edit → Edit blog post
 *   /admin?view=settings             → Site settings
 *
 * This page is client-rendered — all data fetching happens in the browser
 * via Supabase auth + GitHub API.
 */

import AdminShell from '../components/AdminShell.astro';
import AuthButton from '../components/AuthButton.astro';
import CollectionList from '../components/CollectionList.astro';
import ContentEditor from '../components/ContentEditor.astro';
import { COLLECTIONS, COLLECTION_KEYS } from '../lib/schema.js';
import '../styles/admin.css';

// We can't do server-side data fetching here because this is a client-rendered admin.
// The page renders a shell, and JavaScript handles loading data from GitHub API.
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin — CMS</title>
</head>
<body>
  <AdminShell>
    <div slot="auth" id="auth-slot"></div>

    <div id="admin-app">
      <div class="loading-state" id="loading">
        <div class="spinner"></div>
        <p>Loading...</p>
      </div>

      <div id="login-required" style="display:none;">
        <div class="welcome-card">
          <h1>CMS Admin</h1>
          <p>Sign in with your GitHub account to manage content.</p>
        </div>
      </div>

      <div id="not-authorized" style="display:none;">
        <div class="welcome-card">
          <h1>Access denied</h1>
          <p id="not-authorized-msg">Your account does not have admin access to this site.</p>
          <button id="not-authorized-logout" class="btn btn-primary">Sign out</button>
        </div>
      </div>

      <div id="main-content" style="display:none;">
        <!-- Dynamic content rendered here by JS -->
      </div>

      <div id="github-reconnect" style="display:none;">
        <div class="reconnect-card">
          <h2>GitHub access expired</h2>
          <p>Your GitHub login is still active, but the token used to read/write
             content has expired. Reconnect to continue.</p>
          <button id="reconnect-btn" class="btn btn-primary">Reconnect GitHub</button>
        </div>
      </div>
    </div>
  </AdminShell>

  <script>
    import { getSession, getUser, onAuthStateChange } from '../lib/supabase.js';
    import { isAuthError } from '../lib/github.js';
    import { listCollection, getContent, loadCollection } from '../lib/content.js';
    import { COLLECTIONS, COLLECTION_KEYS, getDefaults } from '../lib/schema.js';
    import { loadMedia, saveMedia, scanImages, scanUsage, uploadMedia, addExternalUrl, updateMetadata, deleteMedia, getImageSha } from '../lib/media.js';

    const $ = (sel) => document.querySelector(sel);
    const $loading = $('#loading');
    const $loginRequired = $('#login-required');
    const $notAuthorized = $('#not-authorized');
    const $mainContent = $('#main-content');
    const $authSlot = $('#auth-slot');

    let currentUser = null;
    let githubToken = null;

    // Reference/select field config.
    // list fields that reference another collection's slugs (dropdown of existing items).
    const REFERENCE_TARGETS = {
      relatedServices: 'services',
      relatedBlogs: 'blog',
      relatedPosts: 'blog',
      relatedArticles: 'blog',
      relatedDentists: 'users',
      relatedUsers: 'users',
      relatedTestimonials: 'testimonials',
    };
    // single-value string fields that reference another collection's slugs.
    const SINGLE_REFERENCE_TARGETS = {
      author: 'users',
    };
    // string/tags fields that should suggest distinct existing values from the collection.
    const SUGGEST_FIELDS = ['category', 'specialty'];

    // Fill a <datalist> with option values.
    function fillDatalist(fieldName, values) {
      const dl = document.getElementById(`dl-${fieldName}`);
      if (!dl) return;
      const uniq = Array.from(new Set(values.filter(Boolean).map(String))).sort();
      dl.innerHTML = uniq.map(v => `<option value="${escapeHtml(v)}"></option>`).join('');
    }

    // Populate reference/suggest datalists in the background (non-blocking).
    async function populateFieldOptions(collectionName, fields) {
      // Slug-based reference lists — one cheap listing call per target collection.
      const targets = new Set();
      for (const f of fields) {
        if (f.type === 'list' && REFERENCE_TARGETS[f.name] && COLLECTIONS[REFERENCE_TARGETS[f.name]]) {
          targets.add(f.name);
        }
      }
      for (const name of targets) {
        try {
          const items = await listCollection(githubToken, REFERENCE_TARGETS[name]);
          fillDatalist(name, items.map(i => i.slug));
        } catch {}
      }

      // Single-value string references (e.g. author -> users).
      for (const f of fields) {
        const target = SINGLE_REFERENCE_TARGETS[f.name];
        if (f.type === 'string' && target && COLLECTIONS[target]) {
          try {
            const items = await listCollection(githubToken, target);
            fillDatalist(f.name, items.map(i => i.slug));
          } catch {}
        }
      }

      // Distinct-value suggestions (tags + known string fields) — needs a full scan.
      const scanFields = fields.filter(f => f.type === 'tags' || SUGGEST_FIELDS.includes(f.name));
      if (scanFields.length) {
        try {
          const loaded = await loadCollection(githubToken, collectionName);
          for (const f of scanFields) {
            const vals = new Set();
            for (const it of loaded) {
              const v = it.data?.[f.name];
              if (Array.isArray(v)) v.forEach(x => vals.add(String(x)));
              else if (v !== undefined && v !== null && v !== '') vals.add(String(v));
            }
            fillDatalist(f.name, Array.from(vals));
          }
        } catch {}
      }
    }

    // Parse URL params
    function getParams() {
      const p = new URLSearchParams(window.location.search);
      return {
        collection: p.get('collection'),
        action: p.get('action'),
        slug: p.get('slug'),
        view: p.get('view'),
      };
    }

    // Render auth button
    function renderAuth(user) {
      if (user) {
        $authSlot.innerHTML = `
          <div class="auth-user">
            <img src="${user.avatar}" alt="${user.name}" class="auth-avatar" />
            <div class="auth-info">
              <span class="auth-name">${user.name}</span>
              <button id="logout-btn" class="auth-logout">Sign out</button>
            </div>
          </div>
        `;
        $('#logout-btn')?.addEventListener('click', async () => {
          const { signOut } = await import('../lib/supabase.js');
          await signOut();
          window.location.reload();
        });
      } else {
        $authSlot.innerHTML = `<button id="login-btn" class="auth-login">Sign in with GitHub</button>`;
        $('#login-btn')?.addEventListener('click', async () => {
          const { signInWithGitHub } = await import('../lib/supabase.js');
          await signInWithGitHub();
        });
      }
    }

    const $reconnect = $('#github-reconnect');

    // Re-run GitHub OAuth to fetch a fresh provider_token (token refresh).
    async function reconnectGitHub() {
      const { signInWithGitHub } = await import('../lib/supabase.js');
      await signInWithGitHub();
    }

    // Show the reconnect banner when the GitHub token has expired.
    function showGitHubError(e) {
      if (isAuthError(e)) {
        $mainContent.style.display = 'none';
        $reconnect.style.display = 'block';
        return;
      }
      console.error('[cms-admin] GitHub error:', e);
    }

    $('#reconnect-btn')?.addEventListener('click', reconnectGitHub);

    // Render the dashboard
    function renderDashboard() {
      $mainContent.innerHTML = `
        <div class="welcome-card">
          <h1>Welcome to CMS Admin</h1>
          <p>Select a collection from the sidebar to manage content.</p>
          <div class="dashboard-cards">
            ${COLLECTION_KEYS.map(key => {
              const col = COLLECTIONS[key];
              return `
                <a href="/admin?collection=${key}" class="dashboard-card">
                  <span class="dashboard-card-icon">${col.icon}</span>
                  <span class="dashboard-card-label">${col.label}</span>
                </a>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    // Render collection list
    async function renderCollectionList(collectionName) {
      const col = COLLECTIONS[collectionName];
      if (!col) { renderDashboard(); return; }

      $mainContent.innerHTML = `
        <div class="collection-header">
          <h1 class="collection-title">
            <span class="collection-icon">${col.icon}</span>
            ${col.label}
          </h1>
          <a href="/admin?collection=${collectionName}&action=new" class="btn btn-primary">
            + New ${col.label.replace(/s$/, '')}
          </a>
        </div>
        <div class="loading-state"><div class="spinner"></div><p>Loading ${col.label.toLowerCase()}...</p></div>
      `;

      try {
        const items = await listCollection(githubToken, collectionName);
        // Load frontmatter for each item (needed for display)
        const loaded = [];
        for (const item of items.slice(0, 50)) { // Limit to 50 for performance
          try {
            const content = await getContent(githubToken, collectionName, item.slug);
            if (content) loaded.push(content);
          } catch (e) {
            console.warn(`Failed to load ${item.slug}:`, e);
          }
        }

        if (loaded.length === 0) {
          $mainContent.innerHTML = `
            <div class="collection-header">
              <h1 class="collection-title">
                <span class="collection-icon">${col.icon}</span>
                ${col.label}
              </h1>
              <a href="/admin?collection=${collectionName}&action=new" class="btn btn-primary">
                + New ${col.label.replace(/s$/, '')}
              </a>
            </div>
            <div class="empty-state">
              <p>No ${col.label.toLowerCase()} yet.</p>
              <a href="/admin?collection=${collectionName}&action=new" class="btn btn-primary">
                Create your first ${col.label.replace(/s$/, '').toLowerCase()}
              </a>
            </div>
          `;
          return;
        }

        const rows = loaded.map(item => {
          const title = item.data.title || item.data.name || item.data.question || '—';
          const status = item.data.draft ? '<span class="status-badge draft">Draft</span>'
            : item.data.featured ? '<span class="status-badge featured">Featured</span>'
            : '<span class="status-badge published">Published</span>';
          return `
            <tr>
              <td class="cell-slug"><code>${item.slug}</code></td>
              <td class="cell-title">${title}</td>
              <td class="cell-status">${status}</td>
              <td class="cell-actions">
                <a href="/admin?collection=${collectionName}&slug=${item.slug}&action=edit" class="btn btn-small">Edit</a>
                <button class="btn btn-small btn-danger" data-delete="${collectionName}:${item.slug}">Delete</button>
              </td>
            </tr>
          `;
        }).join('');

        $mainContent.innerHTML = `
          <div class="collection-header">
            <h1 class="collection-title">
              <span class="collection-icon">${col.icon}</span>
              ${col.label}
            </h1>
            <a href="/admin?collection=${collectionName}&action=new" class="btn btn-primary">
              + New ${col.label.replace(/s$/, '')}
            </a>
          </div>
          <div class="item-list">
            <table class="item-table">
              <thead>
                <tr><th>Slug</th><th>Title / Name</th><th>Status</th><th>Actions</th></tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
        `;

        // Attach delete handlers
        $mainContent.querySelectorAll('[data-delete]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const [col, slug] = btn.dataset.delete.split(':');
            if (!confirm(`Delete "${slug}"? This cannot be undone.`)) return;
            try {
              const { deleteContent } = await import('../lib/content.js');
              const item = await getContent(githubToken, col, slug);
              if (!item) { alert('Not found'); return; }
              await deleteContent(githubToken, col, slug, item.sha, item.path);
              renderCollectionList(col);
            } catch (e) {
              alert('Delete failed: ' + e.message);
            }
          });
        });

      } catch (e) {
        if (isAuthError(e)) { showGitHubError(e); return; }
        $mainContent.innerHTML = `
          <div class="error-state">
            <h2>Failed to load</h2>
            <p>${e.message}</p>
            <button class="btn btn-primary" onclick="location.reload()">Retry</button>
          </div>
        `;
      }
    }

    // Render editor form
    async function renderEditor(collectionName, slug, isNew) {
      const col = COLLECTIONS[collectionName];
      if (!col) { renderDashboard(); return; }

      let item = null;
      if (!isNew && slug) {
        $mainContent.innerHTML = `<div class="loading-state"><div class="spinner"></div><p>Loading...</p></div>`;
        try {
          item = await getContent(githubToken, collectionName, slug);
          if (!item) {
            $mainContent.innerHTML = `<div class="error-state"><h2>Not found</h2><p>"${slug}" does not exist in ${col.label}.</p><a href="/admin?collection=${collectionName}" class="btn btn-primary">Back to list</a></div>`;
            return;
          }
         } catch (e) {
           if (isAuthError(e)) { showGitHubError(e); return; }
           $mainContent.innerHTML = `<div class="error-state"><h2>Error</h2><p>${e.message}</p></div>`;
           return;
         }
      }

      const fields = col.fields || [];
      const data = item?.data || {};
      const body = item?.body || '';
      const itemSlug = item?.slug || '';
      const sha = item?.sha || '';

      // Load media metadata so image fields can show/edit alt + SEO from the media library.
      let mediaImages = {};
      const hasImageField = fields.some(f => f.type === 'image');
      if (hasImageField) {
        try {
          const md = await loadMedia(githubToken);
          mediaImages = md.images || {};
        } catch {
          mediaImages = {};
        }
      }
      // _media.json keys are relative to public/ (no leading slash); external images use the full URL.
      const mediaKey = (p) => (!p ? '' : (p.startsWith('http') ? p : p.replace(/^\//, '')));

      const fieldsHtml = fields.map(field => {
        if (field.name === 'body') return '';
        const value = data[field.name] ?? field.default ?? '';
        const req = field.required ? 'required' : '';

        let input = '';
        const suggest = SUGGEST_FIELDS.includes(field.name) || !!SINGLE_REFERENCE_TARGETS[field.name];
        if (field.type === 'string') {
          const listAttr = suggest ? `list="dl-${field.name}"` : '';
          const dl = suggest ? `<datalist id="dl-${field.name}"></datalist>` : '';
          input = `<input type="text" name="${field.name}" value="${escapeHtml(String(value))}" class="field-input" ${listAttr} ${req} />${dl}`;
        } else if (field.type === 'text') {
          input = `<textarea name="${field.name}" class="field-textarea" rows="3" ${req}>${escapeHtml(String(value))}</textarea>`;
        } else if (field.type === 'number') {
          input = `<input type="number" name="${field.name}" value="${value}" class="field-input" min="${field.min ?? ''}" max="${field.max ?? ''}" step="1" />`;
        } else if (field.type === 'date') {
          const dateVal = value ? String(value).split('T')[0] : '';
          input = `<input type="date" name="${field.name}" value="${dateVal}" class="field-input" ${req} />`;
        } else if (field.type === 'boolean') {
          input = `<label class="field-checkbox"><input type="checkbox" name="${field.name}" ${value ? 'checked' : ''} /><span>${field.label}</span></label>`;
        } else if (field.type === 'tags') {
          const tagStr = Array.isArray(value) ? value.join(', ') : value;
          input = `<input type="text" name="${field.name}" value="${escapeHtml(tagStr)}" class="field-input" list="dl-${field.name}" placeholder="tag1, tag2, tag3" /><datalist id="dl-${field.name}"></datalist>`;
        } else if (field.type === 'list') {
          const isRef = !!REFERENCE_TARGETS[field.name];
          const listAttr = isRef ? `list="dl-${field.name}"` : '';
          const items = Array.isArray(value) ? value : [];
          const listItems = items.map(v => `
            <div class="list-item">
              <input type="text" name="${field.name}[]" value="${escapeHtml(String(v))}" class="field-input" ${listAttr} />
              <button type="button" class="btn-remove" title="Remove">&times;</button>
            </div>
          `).join('');
          input = `
            <div class="field-list" data-field="${field.name}"${isRef ? ' data-reference="true"' : ''}>
              <div class="list-items">${listItems}</div>
              <button type="button" class="btn-add-item">+ Add</button>
              ${isRef ? `<datalist id="dl-${field.name}"></datalist>` : ''}
            </div>
          `;
        } else if (field.type === 'image') {
          const meta = mediaImages[mediaKey(String(value))] || {};
          const altValue = meta.alt || '';
          const ogTitle = meta.seo?.ogTitle || '';
          const ogDesc = meta.seo?.ogDescription || '';
          const preview = value ? `<div class="image-preview"><img src="${escapeHtml(String(value))}" alt="${escapeHtml(altValue || field.label)}" /></div>` : '';
          input = `
            <div class="field-image" data-image-field-wrap="${field.name}">
              ${preview}
              <div class="image-field-controls">
                <input type="text" name="${field.name}" value="${escapeHtml(String(value))}" class="field-input" placeholder="/images/..." />
                <button type="button" class="btn-browse" data-image-field="${field.name}">Browse</button>
                <label class="btn-upload-inline">
                  Upload
                  <input type="file" accept="image/*" hidden data-upload-field="${field.name}" />
                </label>
              </div>
              <div class="image-alt-field">
                <input type="text" class="field-input" data-img-alt="${field.name}" value="${escapeHtml(altValue)}" placeholder="Alt text (saved to media library)" />
              </div>
              <details class="image-seo-field">
                <summary>SEO metadata</summary>
                <input type="text" class="field-input" data-img-og-title="${field.name}" value="${escapeHtml(ogTitle)}" placeholder="Open Graph title" style="margin-top:0.5rem;" />
                <input type="text" class="field-input" data-img-og-desc="${field.name}" value="${escapeHtml(ogDesc)}" placeholder="Open Graph description" style="margin-top:0.5rem;" />
              </details>
            </div>
          `;
        } else if (field.type === 'repeatable') {
          const items = Array.isArray(value) ? value : [];
          const subfields = field.fields || [];
          const repeatableItems = items.map((item, i) => {
            const subInputs = subfields.map(sub => `
              <div class="field-group field-group-nested">
                <label class="field-label">${sub.label}</label>
                ${sub.type === 'string'
                  ? `<input type="text" name="${field.name}[${i}].${sub.name}" value="${escapeHtml(item[sub.name] || '')}" class="field-input" />`
                  : `<textarea name="${field.name}[${i}].${sub.name}" class="field-textarea" rows="2">${escapeHtml(item[sub.name] || '')}</textarea>`
                }
              </div>
            `).join('');
            return `
              <div class="repeatable-item">
                <div class="repeatable-item-header"><span>Item ${i + 1}</span><button type="button" class="btn-remove" title="Remove">&times;</button></div>
                ${subInputs}
              </div>
            `;
          }).join('');
          input = `
            <div class="field-repeatable" data-field="${field.name}" data-subfields='${JSON.stringify(subfields)}'>
              <div class="repeatable-items">${repeatableItems}</div>
              <button type="button" class="btn-add-item">+ Add ${field.label.replace(/s$/, '')}</button>
            </div>
          `;
        }

        if (field.type === 'boolean') {
          return `<div class="field-group">${input}</div>`;
        }
        return `
          <div class="field-group">
            <label class="field-label">${field.label}${field.required ? ' <span class="required">*</span>' : ''}</label>
            ${input}
          </div>
        `;
      }).join('');

      const title = isNew ? `New ${col.label.replace(/s$/, '')}` : (data.title || data.name || slug);

      $mainContent.innerHTML = `
        <div class="editor-header">
          <div class="editor-breadcrumb">
            <a href="/admin?collection=${collectionName}">${col.label}</a>
            <span class="breadcrumb-sep">/</span>
            <span>${title}</span>
          </div>
        </div>
        <form id="content-form" class="editor-form">
          <input type="hidden" name="collection" value="${collectionName}" />
          <input type="hidden" name="sha" value="${sha}" />
          <input type="hidden" name="isNew" value="${isNew ? 'true' : 'false'}" />

          ${!isNew ? `
            <div class="field-group">
              <label class="field-label">Slug</label>
              <input type="text" name="slug" value="${itemSlug}" class="field-input" readonly />
            </div>
          ` : `
            <div class="field-group">
              <label class="field-label">Slug *</label>
              <input type="text" name="slug" id="slug" class="field-input" required placeholder="my-item-slug" />
              <p class="field-help">URL-safe identifier (lowercase, hyphens).</p>
            </div>
          `}

          ${fieldsHtml}

          <div class="field-group field-body">
            <label class="field-label">Body</label>
            <textarea name="body" class="field-textarea field-body-textarea" rows="20">${escapeHtml(body)}</textarea>
          </div>

          <div class="editor-actions">
            <button type="submit" class="btn btn-primary btn-save">${isNew ? 'Create' : 'Save Changes'}</button>
            <a href="/admin?collection=${collectionName}" class="btn btn-secondary">Cancel</a>
            ${!isNew ? `<button type="button" class="btn btn-danger btn-delete-item" data-slug="${itemSlug}">Delete</button>` : ''}
          </div>
        </form>
      `;

      // Attach handlers
      attachEditorHandlers(collectionName, isNew);

      // Populate reference/suggestion dropdowns in the background.
      populateFieldOptions(collectionName, fields);
    }

    function escapeHtml(str) {
      return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Set an image field's path input + preview, and optionally prefill alt/SEO.
    function setImageField(fieldName, url, meta) {
      const urlInput = document.querySelector(`[name="${fieldName}"]`);
      if (urlInput) urlInput.value = url;
      const wrap = urlInput?.closest('.field-image');
      if (wrap) {
        let preview = wrap.querySelector('.image-preview');
        if (!preview) {
          preview = document.createElement('div');
          preview.className = 'image-preview';
          wrap.prepend(preview);
        }
        preview.innerHTML = `<img src="${escapeHtml(url)}" alt="${escapeHtml(meta?.alt || fieldName)}" />`;
      }
      if (meta) {
        const altInput = document.querySelector(`[data-img-alt="${fieldName}"]`);
        if (altInput && meta.alt) altInput.value = meta.alt;
        const ogTitleInput = document.querySelector(`[data-img-og-title="${fieldName}"]`);
        if (ogTitleInput && meta.seo?.ogTitle) ogTitleInput.value = meta.seo.ogTitle;
        const ogDescInput = document.querySelector(`[data-img-og-desc="${fieldName}"]`);
        if (ogDescInput && meta.seo?.ogDescription) ogDescInput.value = meta.seo.ogDescription;
      }
    }

    function attachEditorHandlers(collectionName, isNew) {
      // List add/remove
      document.querySelectorAll('.btn-add-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const container = btn.closest('.field-list, .field-repeatable');
          const isRepeatable = container.classList.contains('field-repeatable');

          if (isRepeatable) {
            const subfields = JSON.parse(container.dataset.subfields || '[]');
            const itemsDiv = container.querySelector('.repeatable-items');
            const idx = itemsDiv.children.length;
            const fieldName = container.dataset.field;
            const div = document.createElement('div');
            div.className = 'repeatable-item';
            div.innerHTML = `
              <div class="repeatable-item-header"><span>Item ${idx + 1}</span><button type="button" class="btn-remove">&times;</button></div>
              ${subfields.map(sub => `
                <div class="field-group field-group-nested">
                  <label class="field-label">${sub.label}</label>
                  ${sub.type === 'string'
                    ? `<input type="text" name="${fieldName}[${idx}].${sub.name}" class="field-input" />`
                    : `<textarea name="${fieldName}[${idx}].${sub.name}" class="field-textarea" rows="2"></textarea>`
                  }
                </div>
              `).join('')}
            `;
            itemsDiv.appendChild(div);
            attachRemove(div.querySelector('.btn-remove'));
          } else {
            const itemsDiv = container.querySelector('.list-items');
            const fieldName = container.dataset.field;
            const listAttr = container.dataset.reference === 'true' ? `list="dl-${fieldName}"` : '';
            const div = document.createElement('div');
            div.className = 'list-item';
            div.innerHTML = `
              <input type="text" name="${fieldName}[]" class="field-input" ${listAttr} />
              <button type="button" class="btn-remove">&times;</button>
            `;
            itemsDiv.appendChild(div);
            attachRemove(div.querySelector('.btn-remove'));
          }
        });
      });

      function attachRemove(btn) {
        if (!btn) return;
        btn.addEventListener('click', () => btn.closest('.list-item, .repeatable-item')?.remove());
      }
      document.querySelectorAll('.btn-remove').forEach(attachRemove);

      // Auto-slug
      const slugInput = document.querySelector('[name="slug"]');
      const titleInput = document.querySelector('[name="title"], [name="name"], [name="question"]');
      if (slugInput && titleInput && isNew) {
        titleInput.addEventListener('input', () => {
          if (!slugInput.dataset.manual) {
            slugInput.value = titleInput.value.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();
          }
        });
        slugInput.addEventListener('input', () => { slugInput.dataset.manual = 'true'; });
      }

      // Image field: Browse button → open media library modal
      document.querySelectorAll('[data-image-field]').forEach(btn => {
        btn.addEventListener('click', () => {
          const fieldName = btn.dataset.imageField;
          openMediaPicker(fieldName);
        });
      });

      // Image field: inline upload → uploads to repo AND registers in media library
      document.querySelectorAll('[data-upload-field]').forEach(input => {
        input.addEventListener('change', async (e) => {
          const file = e.target.files?.[0];
          if (!file) return;
          const fieldName = input.dataset.uploadField;
          const label = input.closest('.btn-upload-inline');
          const labelText = label ? label.childNodes[0].textContent : '';
          if (label) label.childNodes[0].textContent = 'Uploading… ';
          try {
            const result = await uploadMedia(githubToken, file, currentUser);
            setImageField(fieldName, result.url);
            showToast('Image uploaded.');
          } catch (err) {
            showToast('Upload failed: ' + err.message, 'error');
          } finally {
            if (label) label.childNodes[0].textContent = labelText;
            input.value = '';
          }
        });
      });

      // Form submit
      document.getElementById('content-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const fd = new FormData(form);
        const col = fd.get('collection');
        const isNewItem = fd.get('isNew') === 'true';
        const sha = fd.get('sha');
        const slug = fd.get('slug');
        if (!slug) { alert('Slug is required.'); return; }

        const schema = COLLECTIONS[col];
        const data = {};
        for (const field of schema.fields) {
          if (field.name === 'body') continue;
          if (field.type === 'boolean') {
            data[field.name] = fd.has(field.name);
          } else if (field.type === 'tags') {
            const raw = fd.get(field.name);
            data[field.name] = raw ? raw.split(',').map(s => s.trim()).filter(Boolean) : [];
          } else if (field.type === 'list') {
            data[field.name] = fd.getAll(`${field.name}[]`).filter(Boolean);
          } else if (field.type === 'number') {
            const val = fd.get(field.name);
            data[field.name] = val ? Number(val) : (field.default ?? 0);
          } else if (field.type === 'repeatable') {
            const items = [];
            for (const [key, val] of fd.entries()) {
              if (!key.startsWith(field.name + '[')) continue;
              const match = key.match(/\[(\d+)\]\.(\w+)/);
              if (!match) continue;
              const idx = parseInt(match[1]);
              while (items.length <= idx) items.push({});
              items[idx][match[2]] = val;
            }
            data[field.name] = items;
          } else {
            const val = fd.get(field.name);
            if (val !== null && val !== '') data[field.name] = val;
          }
        }
        const body = fd.get('body') || '';

        const btn = form.querySelector('.btn-save');
        btn.textContent = 'Saving...';
        btn.disabled = true;

        try {
          const { createContent, updateContent } = await import('../lib/content.js');
           if (isNewItem) {
            await createContent(githubToken, col, slug, data, body);
          } else {
            await updateContent(githubToken, col, slug, data, body, sha, item?.path);
          }

          // Persist image alt/SEO to the media library (_media.json), keyed by image path.
          const toMediaKey = (p) => (!p ? '' : (p.startsWith('http') ? p : p.replace(/^\//, '')));
          for (const field of schema.fields) {
            if (field.type !== 'image') continue;
            const path = (fd.get(field.name) || '').trim();
            if (!path) continue;
            const wrap = form.querySelector(`[data-image-field-wrap="${field.name}"]`);
            if (!wrap) continue;
            const alt = wrap.querySelector(`[data-img-alt="${field.name}"]`)?.value ?? '';
            const ogTitle = wrap.querySelector(`[data-img-og-title="${field.name}"]`)?.value ?? '';
            const ogDescription = wrap.querySelector(`[data-img-og-desc="${field.name}"]`)?.value ?? '';
            if (!alt && !ogTitle && !ogDescription) continue;
            try {
              await updateMetadata(githubToken, toMediaKey(path), { alt, seo: { ogTitle, ogDescription } });
            } catch (metaErr) {
              showToast('Image metadata not saved: ' + metaErr.message, 'error');
            }
          }

          btn.textContent = 'Saved ✓';
          btn.style.background = '#27ae60';
          showToast('Content saved. Deploy will trigger shortly.');
          setTimeout(() => {
            window.location.href = `/admin?collection=${col}`;
          }, 1000);
        } catch (err) {
          showToast('Save failed: ' + err.message, 'error');
          btn.textContent = isNewItem ? 'Create' : 'Save Changes';
          btn.disabled = false;
        }
      });

      // Delete button
      document.querySelector('.btn-delete-item')?.addEventListener('click', async () => {
        const slug = document.querySelector('.btn-delete-item').dataset.slug;
        const col = document.querySelector('[name="collection"]').value;
        if (!confirm(`Delete "${slug}"?`)) return;
        try {
          const { deleteContent } = await import('../lib/content.js');
           const sha = document.querySelector('[name="sha"]').value;
           await deleteContent(githubToken, col, slug, sha, item?.path);
          window.location.href = `/admin?collection=${col}`;
        } catch (err) {
          alert('Delete failed: ' + err.message);
        }
      });
    }

    // Render site settings — generic, works with any config file
    async function renderSettings() {
      $mainContent.innerHTML = `<div class="loading-state"><div class="spinner"></div><p>Loading site settings...</p></div>`;

      try {
        const { readFile, writeFile } = await import('../lib/github.js');
        const { parseConfig, parseSiteConfig, serializeSiteConfig } = await import('../lib/settings.js');
        const { SETTINGS_CONFIG } = await import('../lib/schema.js');

        if (!SETTINGS_CONFIG?.file) {
          $mainContent.innerHTML = `
            <div class="welcome-card">
              <h1>Site Settings</h1>
              <p>No settings file configured. Add <code>settings</code> to your cms-admin integration options:</p>
              <pre style="background:#f1f3f5;padding:1rem;border-radius:6px;font-size:0.85rem;margin-top:1rem;overflow-x:auto;">cmsAdmin({ settings: { file: 'src/config.ts', exportName: 'SITE' } })</pre>
            </div>
          `;
          return;
        }

        const configPath = SETTINGS_CONFIG.file;
        const exportName = SETTINGS_CONFIG.exportName || 'SITE';
        const explicitFields = SETTINGS_CONFIG.fields || null;

        const file = await readFile(githubToken, configPath);
        if (!file) {
          $mainContent.innerHTML = `<div class="error-state"><h2>Config not found</h2><p>Could not find <code>${configPath}</code> in the repository.</p></div>`;
          return;
        }

        const settings = parseSiteConfig(file.content);
        if (!settings) {
          $mainContent.innerHTML = `<div class="error-state"><h2>Parse error</h2><p>Could not parse <code>${configPath}</code>. Make sure it exports a const object.</p></div>`;
          return;
        }
        const sha = file.sha;

        // If explicit fields are provided, use them. Otherwise, auto-generate from the object.
        const fields = explicitFields || autoGenerateFields(settings);

        function getNestedValue(obj, path) {
          return path.split('.').reduce((o, k) => o?.[k], obj);
        }

        function setNestedValue(obj, path, value) {
          const keys = path.split('.');
          const last = keys.pop();
          let current = obj;
          for (const k of keys) {
            if (!current[k] || typeof current[k] !== 'object') current[k] = {};
            current = current[k];
          }
          current[last] = value;
        }

        // Auto-generate fields from object structure
        function autoGenerateFields(obj, prefix = '') {
          const result = [];
          for (const [key, value] of Object.entries(obj)) {
            const fullKey = prefix ? `${prefix}.${key}` : key;
            const label = key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1');

            if (value === null || value === undefined) {
              result.push({ key: fullKey, label, type: 'text', path: !!prefix });
            } else if (typeof value === 'boolean') {
              result.push({ key: fullKey, label, type: 'boolean', path: !!prefix });
            } else if (typeof value === 'number') {
              result.push({ key: fullKey, label, type: 'number', path: !!prefix });
            } else if (Array.isArray(value)) {
              if (value.length > 0 && typeof value[0] === 'object') {
                // Array of objects — skip for now (complex)
                result.push({ key: fullKey, label, type: 'json', path: !!prefix, value: JSON.stringify(value) });
              } else {
                result.push({ key: fullKey, label, type: 'list', path: !!prefix });
              }
            } else if (typeof value === 'object') {
              // Nested object — recurse
              result.push(...autoGenerateFields(value, fullKey));
            } else {
              // String
              const isLong = String(value).length > 80;
              result.push({ key: fullKey, label, type: isLong ? 'textarea' : 'text', path: !!prefix });
            }
          }
          return result;
        }

        // Render form fields
        const fieldsHtml = fields.map(f => {
          const value = f.path ? getNestedValue(settings, f.key) : settings[f.key];
          let input = '';

          if (f.type === 'textarea') {
            input = `<textarea name="${f.key}" class="field-textarea" rows="3">${escapeHtml(String(value ?? ''))}</textarea>`;
          } else if (f.type === 'boolean') {
            input = `<label class="field-checkbox"><input type="checkbox" name="${f.key}" ${value ? 'checked' : ''} /><span>${f.label}</span></label>`;
          } else if (f.type === 'json') {
            input = `<textarea name="${f.key}" class="field-textarea" rows="4" style="font-size:0.8rem;">${escapeHtml(f.value || JSON.stringify(value, null, 2))}</textarea>`;
          } else if (f.type === 'list') {
            const items = Array.isArray(value) ? value : [];
            const listItems = items.map((v, i) => `
              <div class="list-item">
                <input type="text" name="${f.key}[]" value="${escapeHtml(String(v))}" class="field-input" />
                <button type="button" class="btn-remove">&times;</button>
              </div>
            `).join('');
            input = `
              <div class="field-list" data-field="${f.key}">
                <div class="list-items">${listItems}</div>
                <button type="button" class="btn-add-item">+ Add</button>
              </div>
            `;
          } else {
            input = `<input type="${f.type === 'number' ? 'number' : 'text'}" name="${f.key}" value="${escapeHtml(String(value ?? ''))}" class="field-input" step="any" />`;
          }

          if (f.type === 'boolean') {
            return `<div class="field-group">${input}</div>`;
          }
          return `
            <div class="field-group">
              <label class="field-label">${f.label}</label>
              ${input}
            </div>
          `;
        }).join('');

        $mainContent.innerHTML = `
          <div class="editor-header">
            <div class="editor-breadcrumb">
              <a href="/admin">Admin</a>
              <span class="breadcrumb-sep">/</span>
              <span>Site Settings</span>
            </div>
          </div>
          <form id="settings-form" class="editor-form">
            <h2 style="margin-bottom:1.5rem;font-size:1.2rem;">Site Settings</h2>
            <p style="font-size:0.85rem;color:#666;margin-bottom:1.5rem;">
              Editing <code>${configPath}</code>
            </p>
            ${fieldsHtml}
            <div class="editor-actions">
              <button type="submit" class="btn btn-primary btn-save">Save Settings</button>
              <a href="/admin" class="btn btn-secondary">Cancel</a>
            </div>
          </form>
        `;

        // Attach list add/remove handlers
        document.querySelectorAll('.btn-add-item').forEach(btn => {
          btn.addEventListener('click', () => {
            const container = btn.closest('.field-list');
            const fieldName = container.dataset.field;
            const itemsDiv = container.querySelector('.list-items');
            const div = document.createElement('div');
            div.className = 'list-item';
            div.innerHTML = `
              <input type="text" name="${fieldName}[]" class="field-input" />
              <button type="button" class="btn-remove">&times;</button>
            `;
            itemsDiv.appendChild(div);
            div.querySelector('.btn-remove').addEventListener('click', () => div.remove());
          });
        });

        document.querySelectorAll('.btn-remove').forEach(btn => {
          btn.addEventListener('click', () => btn.closest('.list-item')?.remove());
        });

        // Form submit
        document.getElementById('settings-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const form = e.target;
          const fd = new FormData(form);
          const btn = form.querySelector('.btn-save');
          btn.textContent = 'Saving...';
          btn.disabled = true;

          try {
            const newSettings = { ...settings };

            for (const f of fields) {
              if (f.type === 'boolean') {
                const val = fd.has(f.key);
                if (f.path) setNestedValue(newSettings, f.key, val);
                else newSettings[f.key] = val;
              } else if (f.type === 'list') {
                const values = fd.getAll(`${f.key}[]`).filter(Boolean);
                if (f.path) setNestedValue(newSettings, f.key, values);
                else newSettings[f.key] = values;
              } else if (f.type === 'json') {
                try {
                  const val = fd.get(f.key);
                  const parsed = JSON.parse(val);
                  if (f.path) setNestedValue(newSettings, f.key, parsed);
                  else newSettings[f.key] = parsed;
                } catch {
                  // Keep original value if JSON is invalid
                }
              } else {
                const val = fd.get(f.key);
                if (val === null || val === '') continue;
                if (f.type === 'number') {
                  const num = parseFloat(val);
                  if (!isNaN(num)) {
                    if (f.path) setNestedValue(newSettings, f.key, num);
                    else newSettings[f.key] = num;
                  }
                } else {
                  if (f.path) setNestedValue(newSettings, f.key, val);
                  else newSettings[f.key] = val;
                }
              }
            }

            const newContent = serializeSiteConfig(file.content, newSettings, exportName);
            await writeFile(githubToken, configPath, newContent, 'Update site settings', sha);
            btn.textContent = 'Saved ✓';
            btn.style.background = '#27ae60';
            showToast('Settings saved. Deploy will trigger shortly.');
            setTimeout(() => {
              btn.textContent = 'Save Settings';
              btn.style.background = '';
              btn.disabled = false;
            }, 2000);
          } catch (err) {
            showToast('Save failed: ' + err.message, 'error');
            btn.textContent = 'Save Settings';
            btn.disabled = false;
          }
        });

      } catch (e) {
        if (isAuthError(e)) { showGitHubError(e); return; }
        $mainContent.innerHTML = `<div class="error-state"><h2>Error</h2><p>${e.message}</p></div>`;
      }
    }

    // Media Library
    let mediaData = { images: {}, sha: null };
    let mediaUsage = {};
    let selectedMediaPath = null;

    async function renderMediaLibrary() {
      $mainContent.innerHTML = `<div class="loading-state"><div class="spinner"></div><p>Loading media library...</p></div>`;

      try {
        const [loaded, images] = await Promise.all([
          loadMedia(githubToken),
          scanImages(githubToken),
        ]);

        mediaData = loaded;
        console.log(`[cms-admin] Media library: ${images.length} images found in repo, ${Object.keys(mediaData.images).length} entries in _media.json`);

        // Bootstrap: add any repo images not yet in _media.json
        for (const img of images) {
          if (!mediaData.images[img.path]) {
            mediaData.images[img.path] = {
              alt: '',
              title: img.name.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' '),
              caption: '',
              seo: { ogTitle: '', ogDescription: '' },
              size: img.size,
            };
          }
        }

        // Save bootstrapped data if new images were found
        if (images.length > 0 && Object.keys(mediaData.images).length > 0) {
          try {
            mediaData.sha = await saveMedia(githubToken, mediaData, mediaData.sha);
          } catch { /* ignore — user can save manually */ }
        }

        renderMediaGrid();
      } catch (e) {
        if (isAuthError(e)) { showGitHubError(e); return; }
        console.error('[cms-admin] Media library error:', e);
        $mainContent.innerHTML = `<div class="error-state"><h2>Error</h2><p>${e.message}</p><button class="btn btn-primary" onclick="location.reload()">Retry</button></div>`;
      }
    }

    function renderMediaGrid() {
      const entries = Object.entries(mediaData.images);
      const imageCount = entries.length;

      const cards = entries.map(([path, meta]) => {
        const isExternal = path.startsWith('http');
        const thumbUrl = isExternal ? path : `/${path}`;
        const displayName = meta.title || path.split('/').pop();
        const hasAlt = meta.alt && meta.alt.trim();
        return `
          <div class="media-card" data-path="${escapeHtml(path)}">
            <div class="media-thumb">
              <img src="${escapeHtml(thumbUrl)}" alt="${escapeHtml(meta.alt || '')}" loading="lazy" />
              ${!hasAlt ? '<span class="media-badge">No alt</span>' : ''}
              ${isExternal ? '<span class="media-badge media-badge-external">URL</span>' : ''}
            </div>
            <div class="media-card-name">${escapeHtml(displayName)}</div>
          </div>
        `;
      }).join('');

      $mainContent.innerHTML = `
        <div class="media-header">
          <h1 class="collection-title"><span class="nav-icon"> ️</span> Media Library</h1>
          <div class="media-actions">
            <button class="btn btn-secondary" id="btn-add-url">+ Add URL</button>
            <label class="btn btn-primary">
              Upload
              <input type="file" accept="image/*" multiple hidden id="media-upload-input" />
            </label>
          </div>
        </div>
        <div class="media-stats">${imageCount} image${imageCount !== 1 ? 's' : ''}</div>
        <div class="media-grid" id="media-grid">${cards || '<div class="empty-state"><p>No images yet. Upload files, add a URL, or check the browser console for API errors.</p></div>'}</div>
        <div id="media-detail" class="media-detail" style="display:none;"></div>
        <div id="media-upload-overlay" class="media-upload-overlay" style="display:none;">
          <div class="media-upload-zone">
            <div class="media-upload-icon"> </div>
            <p>Drop images here or click to select</p>
            <input type="file" accept="image/*" multiple hidden id="media-drop-input" />
          </div>
        </div>
      `;

      // Card click → open detail
      $mainContent.querySelectorAll('.media-card').forEach(card => {
        card.addEventListener('click', () => {
          selectedMediaPath = card.dataset.path;
          renderMediaDetail(selectedMediaPath);
        });
      });

      // Upload input
      const uploadInput = document.getElementById('media-upload-input');
      uploadInput?.addEventListener('change', (e) => handleMediaUpload(e.target.files));

      // Add URL button
      document.getElementById('btn-add-url')?.addEventListener('click', showAddUrlDialog);

      // Drag-drop overlay
      setupDragDrop();
    }

    function renderMediaDetail(path) {
      const meta = mediaData.images[path];
      if (!meta) return;

      const isExternal = path.startsWith('http');
      const thumbUrl = isExternal ? path : `/${path}`;
      const displayName = meta.title || path.split('/').pop();

      const detail = document.getElementById('media-detail');
      if (!detail) return;

      detail.innerHTML = `
        <div class="detail-inner">
          <button class="detail-close" id="detail-close">&times;</button>
          <div class="detail-preview">
            <img src="${escapeHtml(thumbUrl)}" alt="${escapeHtml(meta.alt || '')}" />
          </div>
          <div class="detail-fields">
            <h3>${escapeHtml(displayName)}</h3>
            <div class="detail-path">${escapeHtml(path)}</div>

            <div class="field-group">
              <label class="field-label">Alt Text</label>
              <input type="text" class="field-input" id="meta-alt" value="${escapeHtml(meta.alt || '')}" placeholder="Describe this image" />
              <p class="field-help">Used for accessibility and SEO</p>
            </div>

            <div class="field-group">
              <label class="field-label">Title</label>
              <input type="text" class="field-input" id="meta-title" value="${escapeHtml(meta.title || '')}" placeholder="Image title" />
            </div>

            <div class="field-group">
              <label class="field-label">Caption</label>
              <textarea class="field-textarea" id="meta-caption" rows="2" placeholder="Optional caption">${escapeHtml(meta.caption || '')}</textarea>
            </div>

            <details class="detail-seo">
              <summary>SEO Fields</summary>
              <div class="field-group">
                <label class="field-label">OG Title</label>
                <input type="text" class="field-input" id="meta-og-title" value="${escapeHtml(meta.seo?.ogTitle || '')}" placeholder="Open Graph title" />
              </div>
              <div class="field-group">
                <label class="field-label">OG Description</label>
                <input type="text" class="field-input" id="meta-og-desc" value="${escapeHtml(meta.seo?.ogDescription || '')}" placeholder="Open Graph description" />
              </div>
            </details>

            <div class="detail-actions">
              <button class="btn btn-primary" id="btn-save-meta">Save</button>
              <button class="btn btn-secondary" id="btn-copy-url">Copy URL</button>
              ${!isExternal ? '<button class="btn btn-danger" id="btn-delete-media">Delete</button>' : ''}
            </div>
          </div>
        </div>
      `;

      detail.style.display = 'block';

      // Close
      document.getElementById('detail-close')?.addEventListener('click', () => {
        detail.style.display = 'none';
        selectedMediaPath = null;
      });

      // Save
      document.getElementById('btn-save-meta')?.addEventListener('click', async () => {
        const btn = document.getElementById('btn-save-meta');
        btn.textContent = 'Saving...';
        btn.disabled = true;
        try {
          const metadata = {
            alt: document.getElementById('meta-alt').value,
            title: document.getElementById('meta-title').value,
            caption: document.getElementById('meta-caption').value,
            seo: {
              ogTitle: document.getElementById('meta-og-title').value,
              ogDescription: document.getElementById('meta-og-desc').value,
            },
          };
          const result = await updateMetadata(githubToken, path, metadata);
          mediaData.images[path] = { ...mediaData.images[path], ...metadata };
          mediaData.sha = result.mediaSha;
          btn.textContent = 'Saved \u2713';
          btn.style.background = '#27ae60';
          showToast('Metadata saved.');
          setTimeout(() => {
            btn.textContent = 'Save';
            btn.style.background = '';
            btn.disabled = false;
            renderMediaGrid();
          }, 1500);
        } catch (e) {
          showToast('Save failed: ' + e.message, 'error');
          btn.textContent = 'Save';
          btn.disabled = false;
        }
      });

      // Copy URL
      document.getElementById('btn-copy-url')?.addEventListener('click', () => {
        const url = isExternal ? path : `/${path}`;
        navigator.clipboard.writeText(url).then(() => showToast('URL copied.'));
      });

      // Delete
      document.getElementById('btn-delete-media')?.addEventListener('click', async () => {
        if (!confirm(`Delete "${displayName}"? This cannot be undone.`)) return;
        try {
          const imageSha = await getImageSha(githubToken, path);
          await deleteMedia(githubToken, path, mediaData.sha, imageSha);
          delete mediaData.images[path];
          selectedMediaPath = null;
          renderMediaGrid();
          showToast('Image deleted.');
        } catch (e) {
          showToast('Delete failed: ' + e.message, 'error');
        }
      });
    }

    async function handleMediaUpload(files) {
      if (!files || files.length === 0) return;

      const overlay = document.getElementById('media-upload-overlay');
      if (overlay) overlay.style.display = 'flex';

      let uploaded = 0;
      const total = files.length;

      for (const file of files) {
        try {
          const result = await uploadMedia(githubToken, file, currentUser);
          mediaData.images[result.path] = result.entry;
          mediaData.sha = result.mediaSha;
          uploaded++;
          showToast(`Uploaded ${uploaded}/${total}: ${file.name}`);
        } catch (e) {
          showToast(`Failed to upload ${file.name}: ${e.message}`, 'error');
        }
      }

      if (overlay) overlay.style.display = 'none';
      renderMediaGrid();

      // Open detail for first uploaded
      if (uploaded > 0) {
        const firstPath = Object.keys(mediaData.images).pop();
        if (firstPath) {
          selectedMediaPath = firstPath;
          renderMediaDetail(firstPath);
        }
      }
    }

    function showAddUrlDialog() {
      const dialog = document.createElement('div');
      dialog.className = 'media-dialog-overlay';
      dialog.innerHTML = `
        <div class="media-dialog">
          <h3>Add Image URL</h3>
          <div class="field-group">
            <label class="field-label">Image URL</label>
            <input type="url" class="field-input" id="dialog-url" placeholder="https://images.unsplash.com/..." />
          </div>
          <div id="dialog-preview" class="media-dialog-preview"></div>
          <div class="media-dialog-actions">
            <button class="btn btn-secondary" id="dialog-cancel">Cancel</button>
            <button class="btn btn-primary" id="dialog-confirm">Add</button>
          </div>
        </div>
      `;
      document.body.appendChild(dialog);

      const urlInput = document.getElementById('dialog-url');
      const preview = document.getElementById('dialog-preview');

      urlInput?.addEventListener('input', () => {
        const url = urlInput.value.trim();
        if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
          preview.innerHTML = `<img src="${escapeHtml(url)}" alt="Preview" style="max-width:200px;max-height:120px;border-radius:4px;" />`;
        } else {
          preview.innerHTML = '';
        }
      });

      document.getElementById('dialog-cancel')?.addEventListener('click', () => dialog.remove());

      document.getElementById('dialog-confirm')?.addEventListener('click', async () => {
        const url = urlInput.value.trim();
        if (!url) return;
        try {
          const result = await addExternalUrl(githubToken, url, { alt: '', title: url.split('/').pop() });
          mediaData.images[url] = result.entry;
          mediaData.sha = result.mediaSha;
          dialog.remove();
          renderMediaGrid();
          selectedMediaPath = url;
          renderMediaDetail(url);
          showToast('Image URL added.');
        } catch (e) {
          showToast('Failed: ' + e.message, 'error');
        }
      });
    }

    function setupDragDrop() {
      const grid = document.getElementById('media-grid');
      if (!grid) return;

      let dragCounter = 0;

      document.addEventListener('dragenter', (e) => {
        e.preventDefault();
        dragCounter++;
        const overlay = document.getElementById('media-upload-overlay');
        if (overlay) overlay.style.display = 'flex';
      });

      document.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dragCounter--;
        if (dragCounter <= 0) {
          dragCounter = 0;
          const overlay = document.getElementById('media-upload-overlay');
          if (overlay) overlay.style.display = 'none';
        }
      });

      document.addEventListener('dragover', (e) => e.preventDefault());

      document.addEventListener('drop', (e) => {
        e.preventDefault();
        dragCounter = 0;
        const overlay = document.getElementById('media-upload-overlay');
        if (overlay) overlay.style.display = 'none';

        const files = [...(e.dataTransfer?.files || [])].filter(f => f.type.startsWith('image/'));
        if (files.length > 0) handleMediaUpload(files);
      });
    }

    // Media Picker — opens media library in a modal for content editor image fields
    async function openMediaPicker(fieldName) {
      const modal = document.createElement('div');
      modal.className = 'media-dialog-overlay';
      modal.innerHTML = `
        <div class="media-dialog media-picker-dialog">
          <div class="media-picker-head">
            <h3 style="margin:0;">Select Image</h3>
            <button class="detail-close" id="picker-close" aria-label="Close">&times;</button>
          </div>
          <div class="media-grid" id="picker-grid">
            <div class="loading-state" style="grid-column:1/-1;"><div class="spinner"></div><p>Loading images…</p></div>
          </div>
          <div class="media-picker-foot">
            <label class="btn btn-secondary" style="cursor:pointer;">
              Upload new
              <input type="file" accept="image/*" hidden id="picker-upload" />
            </label>
            <input type="url" class="field-input" id="picker-manual-url" placeholder="Or paste image URL…" style="flex:1;" />
            <button class="btn btn-secondary" id="picker-use-url">Use URL</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);

      const close = () => modal.remove();
      document.getElementById('picker-close')?.addEventListener('click', close);
      modal.addEventListener('click', (e) => { if (e.target === modal) close(); });

      // Load repo images + metadata in parallel, then merge.
      let mediaImages = {};
      let scanned = [];
      try {
        const [media, imgs] = await Promise.all([
          loadMedia(githubToken).catch(() => ({ images: {} })),
          scanImages(githubToken).catch(() => []),
        ]);
        mediaImages = media.images || {};
        scanned = imgs || [];
      } catch {}

      // Merge: every scanned repo image + any external URLs recorded in metadata.
      const byPath = new Map();
      for (const img of scanned) byPath.set(img.path, { path: img.path, url: img.url, meta: mediaImages[img.path] || {} });
      for (const [path, meta] of Object.entries(mediaImages)) {
        if (path.startsWith('http')) byPath.set(path, { path, url: path, meta });
        else if (!byPath.has(path)) byPath.set(path, { path, url: `/${path}`, meta });
      }
      const items = Array.from(byPath.values());

      const pick = (url, meta) => { setImageField(fieldName, url, meta); close(); };

      const grid = modal.querySelector('#picker-grid');
      if (items.length === 0) {
        grid.innerHTML = '<div class="empty-state" style="grid-column:1/-1;"><p>No images found. Upload one or paste a URL below.</p></div>';
      } else {
        grid.innerHTML = items.map((it, i) => `
          <div class="media-card" data-picker-idx="${i}">
            <div class="media-thumb">
              <img src="${escapeHtml(it.url)}" alt="${escapeHtml(it.meta.alt || '')}" loading="lazy" />
            </div>
            <div class="media-card-name">${escapeHtml(it.meta.title || it.path.split('/').pop())}</div>
          </div>
        `).join('');
        grid.querySelectorAll('[data-picker-idx]').forEach(card => {
          card.addEventListener('click', () => {
            const it = items[Number(card.dataset.pickerIdx)];
            pick(it.url, it.meta);
          });
        });
      }

      // Manual URL
      document.getElementById('picker-use-url')?.addEventListener('click', () => {
        const url = document.getElementById('picker-manual-url')?.value.trim();
        if (!url) return;
        pick(url, mediaImages[url] || null);
      });

      // Upload from within the picker
      document.getElementById('picker-upload')?.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        grid.innerHTML = '<div class="loading-state" style="grid-column:1/-1;"><div class="spinner"></div><p>Uploading…</p></div>';
        try {
          const result = await uploadMedia(githubToken, file, currentUser);
          pick(result.url, result.entry);
        } catch (err) {
          showToast('Upload failed: ' + err.message, 'error');
          close();
        }
      });
    }

    // Toast notification
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 10);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Access control: a signed-in GitHub user may use the admin only if the
    // site's `users` collection contains an entry with role 'admin' whose
    // `email` or `githubUsername` matches the signed-in account. An optional
    // PUBLIC_ADMIN_EMAILS env allow-list acts as an escape hatch. If no admins
    // are configured anywhere, any authenticated user is allowed (bootstrap).
    async function isAuthorizedAdmin(user) {
      if (!user) return false;
      const identifiers = [user.email, user.username]
        .filter(Boolean)
        .map((s) => String(s).toLowerCase());

      const envAllow = (import.meta.env.PUBLIC_ADMIN_EMAILS || '')
        .split(',')
        .map((s) => s.trim().toLowerCase())
        .filter(Boolean);

      let admins = [];
      if (COLLECTIONS.users) {
        try {
          const entries = await loadCollection(githubToken, 'users');
          admins = entries
            .filter((e) => Array.isArray(e.data.roles) && e.data.roles.includes('admin'))
            .flatMap((e) => [e.data.email, e.data.githubUsername])
            .filter(Boolean)
            .map((s) => String(s).toLowerCase());
        } catch (e) {
          console.warn('[cms-admin] Could not load users collection for access control:', e);
        }
      }

      const allow = [...admins, ...envAllow];
      if (allow.length === 0) return true;
      return identifiers.some((id) => allow.includes(id));
    }

    function showNotAuthorized() {
      $loading.style.display = 'none';
      $mainContent.style.display = 'none';
      $notAuthorized.style.display = 'block';
      $('#not-authorized-logout')?.addEventListener('click', async () => {
        const { signOut } = await import('../lib/supabase.js');
        await signOut();
        window.location.reload();
      });
    }

    // Initialize
    async function init() {
      try {
        const session = await getSession();
        if (session) {
          currentUser = await getUser();
          githubToken = session.provider_token;
        }
      } catch (e) {
        console.warn('Auth check failed:', e);
      }

      renderAuth(currentUser);

      if (!currentUser) {
        $loading.style.display = 'none';
        $loginRequired.style.display = 'block';
        return;
      }

      if (!(await isAuthorizedAdmin(currentUser))) {
        showNotAuthorized();
        return;
      }

      $loading.style.display = 'none';
      $reconnect.style.display = 'none';
      $mainContent.style.display = 'block';

      const params = getParams();

      if (params.view === 'settings') {
        await renderSettings();
      } else if (params.view === 'media') {
        await renderMediaLibrary();
      } else if (params.action === 'new' && params.collection) {
        await renderEditor(params.collection, null, true);
      } else if (params.action === 'edit' && params.collection && params.slug) {
        await renderEditor(params.collection, params.slug, false);
      } else if (params.collection) {
        await renderCollectionList(params.collection);
      } else {
        renderDashboard();
      }
    }

    init();
  </script>

