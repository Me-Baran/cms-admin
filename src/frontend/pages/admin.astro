      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .detail-inner {
      display: flex;
      gap: 1.5rem;
      padding: 1.5rem;
      position: relative;
    }

    .detail-close {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      background: none;
      border: none;
      font-size: 1.5rem;
      color: #888;
      cursor: pointer;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
    }

    .detail-close:hover { background: #f1f3f5; color: #333; }

    .detail-preview {
      flex-shrink: 0;
      width: 280px;
    }

    .detail-preview img {
      width: 100%;
      max-height: 300px;
      object-fit: contain;
      border-radius: 6px;
      border: 1px solid #e9ecef;
      background: #f8f9fa;
    }

    .detail-fields { flex: 1; min-width: 0; }
    .detail-fields h3 { margin: 0 0 0.25rem; font-size: 1.1rem; }
    .detail-path { font-size: 0.75rem; color: #888; margin-bottom: 1rem; font-family: monospace; }

    .detail-seo { margin-top: 1rem; }
    .detail-seo summary {
      font-size: 0.8rem;
      font-weight: 600;
      color: #666;
      cursor: pointer;
      margin-bottom: 0.75rem;
    }

    .detail-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #e9ecef;
    }

    /* Upload overlay */
    .media-upload-overlay {
      position: fixed;
      inset: 0;
      background: rgba(26, 26, 46, 0.85);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .media-upload-zone {
      background: #fff;
      border: 3px dashed #4A90D9;
      border-radius: 16px;
      padding: 3rem 4rem;
      text-align: center;
      color: #333;
    }

    .media-upload-icon { font-size: 3rem; margin-bottom: 0.5rem; }

    /* URL Dialog */
    .media-dialog-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .media-dialog {
      background: #fff;
      border-radius: 12px;
      padding: 1.5rem;
      width: 100%;
      max-width: 450px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    }

    .media-dialog h3 { margin: 0 0 1rem; }

    .media-picker-dialog {
      max-width: 760px;
      max-height: 82vh;
      display: flex;
      flex-direction: column;
    }
    .media-picker-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .media-picker-dialog .media-grid {
      overflow-y: auto;
      flex: 1;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      align-content: start;
    }
    .media-picker-foot {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid #e9ecef;
    }

    .media-dialog-preview {
      min-height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0.75rem 0;
    }

    .media-dialog-actions {
      display: flex;
      gap: 0.5rem;
      justify-content: flex-end;
      margin-top: 1rem;
    }

    /* Image field in editor */
    .image-field-controls {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .image-field-controls .field-input { flex: 1; }

    .btn-browse {
      padding: 0.55rem 0.75rem;
      background: #f1f3f5;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-browse:hover { background: #e9ecef; }

    .btn-upload-inline {
      padding: 0.55rem 0.75rem;
      background: #f1f3f5;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-upload-inline:hover { background: #e9ecef; }

    .image-alt-field { margin-top: 0.5rem; }

    .image-seo-field { margin-top: 0.5rem; }
    .image-seo-field summary {
      cursor: pointer;
      font-size: 0.8rem;
      color: #666;
      user-select: none;
    }
    .image-seo-field summary:hover { color: #333; }
  </style>
</body>
